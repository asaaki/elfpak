# syntax=docker/dockerfile:1

# musl smoke test. musl-specific behaviour is a non-goal, but generic ELF
# handling has to work: the loader and libc are the same file, reached through a
# symlink, and there is no ld.so.cache to consult.
#
# Built for every architecture under test in one buildx invocation; compiling a
# single C file under emulation is cheap enough to cover both.

# Base images are pinned by tag *and* digest so a build is reproducible and the
# toolchain never moves under us. Refresh a digest with:
#   docker buildx imagetools inspect <tag> --format '{{.Manifest.Digest}}'
ARG ELFPAK_IMAGE=elfpak:local
# The Rust Alpine image, which the elfpak image is built from as well, already
# ships Alpine's gcc and musl headers. Using it here keeps the pinning promise
# honest: `apk add` would fetch whatever the mirror holds today, so a digest
# would no longer describe the build. It also drops the only step in this test
# that needed the network, and reuses a layer the suite has already pulled.
ARG RUST_IMAGE=rust:1.98.0-alpine3.24@sha256:a10e64dd139b7387337c7fbe8aca31b959b57b2fd4c8ae20a02cf1d6ea424dce

FROM ${ELFPAK_IMAGE} AS elfpak

FROM ${RUST_IMAGE} AS build

COPY fixtures/musl-hello/main.c /src/main.c

RUN cc -o /musl-hello /src/main.c

COPY --from=elfpak /elfpak /usr/local/bin/elfpak

RUN elfpak bundle /musl-hello \
    --output /rootfs \
    --install /app/hello \
    --preset minimal \
    -v

FROM scratch

COPY --from=build /rootfs /

ENTRYPOINT ["/app/hello"]
